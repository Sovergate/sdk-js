{
  "name": "sovergate",
  "version": "0.1.0-alpha.1",
  "description": "EU AI Act compliance SDK — automatic, non-invasive audit logging for LLM calls",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest --testEnvironment node",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "eu-ai-act",
    "compliance",
    "gdpr",
    "llm",
    "audit",
    "openai",
    "anthropic",
    "pii",
    "observability"
  ],
  "license": "MIT",
  "author": "Roberto Postolovski",
  "homepage": "https://sovergate.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovergate/sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/sovergate/sdk-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "openai": "^7.43.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
